# ---------------------------------------------------------------------------
# ninesys-mcp-server — configuración de entorno
# ---------------------------------------------------------------------------

# Puerto local donde escucha el servidor MCP (Nginx hace el reverse-proxy HTTPS
# desde mcp.nineteengreen.com / mcp.ninesys19.com hacia este puerto).
PORT=3100

# URL base de ninesys-api. El MCP consume sus endpoints /internal/*.
#   Dev:  https://api.nineteengreen.com   (ajustar al real de Desarrollo)
#   Prod: https://api.ninesys19.com
NINESYS_API_URL=https://api.ninesys19.com

# URL base del CDN (galería de imágenes por empresa).
#   Dev:  https://cdn.nineteengreen.com
#   Prod: https://cdn.ninesys19.com
NINESYS_CDN_URL=https://cdn.ninesys19.com

# Token interno que ninesys-api exige en el header X-Internal-Token de los
# endpoints /internal/*. DEBE coincidir con MSG_SERVICE_INTERNAL_TOKEN del .env
# de la API en ESTE mismo servidor.
MSG_SERVICE_INTERNAL_TOKEN=

# Tokens Bearer válidos de las apps que consumen el MCP, separados por coma.
# Cada app (msg_ninesys, app_multi, 19print, ...) usa uno distinto para poder
# revocarlos de forma independiente. Genera cada uno con, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Formato recomendado: "nombre:token" para poder identificar al llamador en logs.
#   MCP_CLIENT_TOKENS=msg:9f8a...,appmulti:1c3d...
MCP_CLIENT_TOKENS=

# Nivel de log de pino (trace|debug|info|warn|error). Producción: info.
LOG_LEVEL=info

# Timeout duro (ms) por llamada a la API antes de reintentar.
API_TIMEOUT_MS=5000
