{
  "name": "ninesys-mcp-server",
  "version": "0.1.0",
  "description": "Servidor MCP del ecosistema Ninesys: capa única de herramientas de lectura sobre los endpoints /internal de ninesys-api, para que cualquier app con IA obtenga datos (catálogo, órdenes, clientes, tallas, telas, horario, galería) vía tool-use.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2-logs": "pm2 logs ninesys-mcp-server"
  },
  "keywords": [
    "mcp",
    "ninesys",
    "ia"
  ],
  "author": "Ninesys",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
